#include <GL/freeglut.h>
#include <cstdlib>

// Posicao da esfera
float esferaX = 0.0f;
float esferaZ = 0.0f;

// Posicao da lampada
float luzX = 0.0f;
float luzY = 4.0f;
float luzZ = 2.0f;

// Tamanho da janela
int largura = 800;
int altura = 600;

void desenhar()
{
 glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

 glMatrixMode(GL_MODELVIEW);
 glLoadIdentity();

 // Camera
 gluLookAt(
 7.0, 6.0, 9.0,
 0.0, 0.5, 0.0,
 0.0, 1.0, 0.0
 );

 // Posicao da luz
 GLfloat posicaoLuz[] = { luzX, luzY, luzZ, 1.0f };
 glLightfv(GL_LIGHT0, GL_POSITION, posicaoLuz);

 // Base
 glColor3f(0.5f, 0.5f, 0.5f);

 glPushMatrix();
 glTranslatef(0.0f, -0.1f, 0.0f);
 glScalef(10.0f, 0.2f, 10.0f);
 glutSolidCube(1.0);
 glPopMatrix();

 // Esfera
 glColor3f(0.1f, 0.4f, 1.0f);

 glPushMatrix();
 glTranslatef(esferaX, 1.0f, esferaZ);
 glutSolidSphere(1.0, 20, 20);
 glPopMatrix();

 // Representacao da lampada
 glDisable(GL_LIGHTING);

 glColor3f(1.0f, 1.0f, 0.0f);

 glPushMatrix();
 glTranslatef(luzX, luzY, luzZ);
 glutSolidSphere(0.2, 15, 15);
 glPopMatrix();

 glEnable(GL_LIGHTING);

 glutSwapBuffers();
}

// Teclas normais
void teclado(unsigned char tecla, int x, int y)
{
 switch (tecla)
 {
 case '1':
 glShadeModel(GL_FLAT);
 glutSetWindowTitle("ICG - Flat Shading");
 break;

 case '2':
 glShadeModel(GL_SMOOTH);
 glutSetWindowTitle("ICG - Gouraud Shading");
 break;

 case 27: // ESC
 exit(0);
 break;
 }

 glutPostRedisplay();
}

// Setas movimentam a esfera
void setas(int tecla, int x, int y)
{
 float velocidade = 0.2f;

 switch (tecla)
 {
 case GLUT_KEY_LEFT:
 esferaX -= velocidade;
 break;

 case GLUT_KEY_RIGHT:
 esferaX += velocidade;
 break;

 case GLUT_KEY_UP:
 esferaZ -= velocidade;
 break;

 case GLUT_KEY_DOWN:
 esferaZ += velocidade;
 break;
 }

 // Limita a esfera dentro da base
 if (esferaX < -4.0f) esferaX = -4.0f;
 if (esferaX > 4.0f) esferaX = 4.0f;
 if (esferaZ < -4.0f) esferaZ = -4.0f;
 if (esferaZ > 4.0f) esferaZ = 4.0f;

 glutPostRedisplay();
}

// Mouse movimenta a lampada
void moverMouse(int x, int y)
{
 luzX = ((float)x / largura) * 10.0f - 5.0f;
 luzZ = ((float)y / altura) * 10.0f - 5.0f;

 glutPostRedisplay();
}

// Ajusta a projecao ao redimensionar
void redimensionar(int w, int h)
{
 if (h == 0)
h = 1;

 largura = w;
 altura = h;

 glViewport(0, 0, w, h);

 glMatrixMode(GL_PROJECTION);
 glLoadIdentity();

 gluPerspective(
 45.0,
 (float)w / (float)h,
 0.1,
 100.0
 );

 glMatrixMode(GL_MODELVIEW);
}

void inicializar()
{
 glClearColor(0.1f, 0.1f, 0.15f, 1.0f);

 glEnable(GL_DEPTH_TEST);

 glEnable(GL_LIGHTING);
 glEnable(GL_LIGHT0);

 glEnable(GL_COLOR_MATERIAL);
 glColorMaterial(GL_FRONT_AND_BACK, GL_AMBIENT_AND_DIFFUSE);

 GLfloat ambiente[] = { 0.2f, 0.2f, 0.2f, 1.0f };
 GLfloat difusa[] = { 1.0f, 1.0f, 1.0f, 1.0f };

 glLightfv(GL_LIGHT0, GL_AMBIENT, ambiente);
 glLightfv(GL_LIGHT0, GL_DIFFUSE, difusa);

 // Comeca com Gouraud
 glShadeModel(GL_SMOOTH);
}

int main(int argc, char** argv)
{
 glutInit(&argc, argv);

 glutInitDisplayMode(
 GLUT_DOUBLE |
 GLUT_RGB |
 GLUT_DEPTH
 );

 glutInitWindowSize(800, 600);
 glutInitWindowPosition(100, 100);

 glutCreateWindow("ICG - Gouraud Shading");

 inicializar();

 glutDisplayFunc(desenhar);
 glutReshapeFunc(redimensionar);
 glutKeyboardFunc(teclado);
 glutSpecialFunc(setas);
 glutPassiveMotionFunc(moverMouse);

 glutMainLoop();

 return 0;
}
